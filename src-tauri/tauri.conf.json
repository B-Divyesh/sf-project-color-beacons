{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project Color Beacons",
  "version": "0.1.6",
  "identifier": "in.sociobot.project-color-beacons",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist/app"
  },
  "app": {
    "windows": [
      {
        "title": "Project Color Beacons",
        "width": 1060,
        "height": 760,
        "minWidth": 360,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.sociobot.in"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Mark the right project before you edit",
    "longDescription": "Assign a local color, name, and symbol to each project folder, then confirm it before focus-sensitive work.",
    "copyright": "Copyright 2026 Sociobot",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
