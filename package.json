{
  "name": "project-color-beacons",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.app.config.ts",
    "dev:site": "vite --config vite.site.config.ts",
    "build": "npm run build:app && npm run build:site",
    "build:app": "vite build --config vite.app.config.ts",
    "build:site": "vite build --config vite.site.config.ts",
    "tauri": "tauri",
    "test": "playwright test",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:live:billing": "node scripts/verify-live-billing.mjs",
    "test:live:site": "node scripts/verify-live-site.mjs",
    "test:release": "node scripts/verify-published-release.mjs",
    "lint": "eslint app/src shared site/src tests vite.*.ts playwright.config.ts vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-opener": "2.5.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "22.18.0",
    "eslint": "10.9.1",
    "typescript": "5.9.2",
    "typescript-eslint": "8.68.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
